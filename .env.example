# 项目名称
PROJECT_NAME=agenthub

# API DLL 文件名
APP_DLL_NAME=Sb.Apps.AgentHub.WebApi.dll

# 对外端口（四端口分离，9000 段）
CHAT_PORT=9000
ADMIN_PORT=9001
API_PORT=9002
WIDGET_PORT=9003

# PostgreSQL（首次部署由 deploy.sh 自动生成密码）
POSTGRES_DB=sb_agent_hub
POSTGRES_PASSWORD=ChangeMePlease

# JWT 密钥（首次部署由 deploy.sh 自动生成，至少 32 字符）
JWT_ADMIN_KEY=ChangeMePlease_ChangeMePlease123456
JWT_API_KEY=ChangeMePlease_ChangeMePlease7890

# 默认管理员账号（首次启动自动创建）
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin123

# 强制 HTTPS/WSS（默认开启，反向代理后协议识别有问题时保持 true）
FORCE_HTTPS=true

# 数据持久化
# 留空 = Docker 命名卷（内置）
# 填路径 = 绑定挂载到宿主目录（外置）
#   POSTGRES_DATA_PATH=./data/postgresql
#   REDIS_DATA_PATH=./data/redis
#   UPLOAD_DATA_PATH=./data/upload
POSTGRES_DATA_PATH=
REDIS_DATA_PATH=
UPLOAD_DATA_PATH=
